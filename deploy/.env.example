# ~/apps/portfolio/.env on the host. The first deploy creates it if missing.
# No secrets: the site is static. Keep it 600 anyway, like the other apps.

# Set by every deploy (the 12-character commit SHA of the image).
IMAGE_TAG=

# Host port the container binds on 127.0.0.1. Must be free on the shared host
# (confession uses 32790): `sudo ss -ltn | grep 3279`. If you change it,
# change proxy_pass in nginx-portfolio.conf to match.
HOST_PORT=32791
